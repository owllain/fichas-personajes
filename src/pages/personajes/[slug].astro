---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CharacterSheet } from '../../components/character/CharacterSheet';
import { characters, characterSlug } from '../../data/characters';

export function getStaticPaths() {
  return characters.map((character) => ({ params: { slug: characterSlug(character.name) }, props: { character } }));
}

const { character } = Astro.props;
---
<BaseLayout title={`${character.name} // ${character.role}`} description={character.alias}>
  <main class="sheet-page">
    <a class="sheet-back" href="/">← Volver al archivo</a>
    <CharacterSheet client:load character={character} />
  </main>
</BaseLayout>
